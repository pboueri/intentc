target: core/specifications
version: 1
validations:
  - name: core-modules-exist
    type: file_exists
    severity: error
    args:
      paths:
        - "intentc/__init__.py"
        - "intentc/core/__init__.py"
        - "intentc/core/models.py"
        - "intentc/core/parser.py"
        - "intentc/core/tests/test_*.py"

  - name: core-tests-pass
    type: command_validation
    severity: error
    args:
      cwd: "."
      command: "uv run pytest {output_dir}/intentc/core -q"

  - name: core-types-defined
    type: agent_validation
    severity: error
    args:
      rubric: |
        Verify the core modules define IntentFile, ProjectIntent, Implementation,
        Validation, ValidationFile, ValidationType (with agent_validation,
        command_validation, file_exists), Severity, ParseError, ParseErrors and
        content_hash, and that the core package has no dependency on any build,
        cli, or differencing module.

  - name: icv-parse-errors-are-actionable
    type: agent_validation
    severity: error
    args:
      rubric: |
        Verify tests demonstrate that a .icv file with a duplicate validation name,
        an unknown severity, and an agent_validation without a rubric each produce
        a ParseErrors exception whose messages include the file path and the
        offending validation entry. Verify an empty .icv file parses to an empty
        ValidationFile without error.
