target: build/agents
version: 1
validations:
  - name: agents-tests-pass
    type: command_validation
    severity: error
    args:
      cwd: "."
      command: "uv run pytest {output_dir}/intentc/build/agents -q"

  - name: prompts-bundled
    type: file_exists
    severity: error
    args:
      paths:
        - "intentc/build/agents/prompts/build.prompt"
        - "intentc/build/agents/prompts/validate.prompt"
        - "intentc/build/agents/prompts/plan.prompt"

  - name: agent-module-exists
    type: agent_validation
    severity: error
    args:
      rubric: |
        Verify that the agent module exists within the output directory's main package
        and contains the core agent types and implementations.

  - name: agent-interface-defined
    type: agent_validation
    severity: error
    args:
      rubric: |
        Verify the agent module defines:
        1. Agent interface with build, validate, difference, plan, get_name, get_type methods
        2. BuildContext type with all specified fields including response_file_path, previous_errors and feature_path
        3. DifferencingContext type with fields: output_dir_a, output_dir_b, project_intent, implementation, response_file_path
        4. CLIAgent base implementation that constructs prompts and reads response files
        5. ClaudeAgent with Claude-specific flags (-p, --output-format stream-json, --permission-mode auto --permission-prompts none by default, --dangerously-skip-permissions only when permission_mode is bypassPermissions, --model)
        6. create_from_profile factory function
        7. MockAgent for testing (records all calls including Difference, returns configurable responses)
        8. BuildResponse, ValidationResponse, DimensionResult, and DifferencingResponse types
        9. AgentProfile with timeout default of 3600.0 seconds
        10. PromptTemplates, load_default_prompts(), render_prompt(), render_differencing_prompt(); render_prompt supplies {output_dir}, {dependencies}, {feature_name} and never raises KeyError for a template using only documented variables

  - name: agent-tests-pass
    type: agent_validation
    severity: error
    args:
      rubric: |
        Run the test suite for the agent module and verify all tests pass with exit code 0.
        Use the implementation's test runner (e.g., pytest for Python, go test for Go).
